# Copiez ce fichier en ".env" et remplissez au fur et à mesure que vous obtenez les accès.
# Tant qu'une plateforme n'a pas ses clés, l'app fonctionne pour elle en MODE SIMULATION
# (les publications et stats sont fictives, ce qui permet de tester tout le flux dès maintenant).

# --- Sécurité de l'app ---
SECRET_KEY=change-moi-en-production
DATABASE_URL=sqlite:///./data/runnergolf.db

# Adresse publique de CETTE application, sans slash final.
# Obligatoire en production : Instagram télécharge les médias depuis cette URL,
# et c'est elle qui active les cookies sécurisés (HTTPS).
PUBLIC_BASE_URL=

# --- Intégration ERP (onglet "Communication") ---
# Secret partagé avec l'ERP pour la connexion automatique (SSO).
# Doit être STRICTEMENT identique à MARKETING_SSO_SECRET dans le .env de l'ERP.
# Générer avec : python3 -c "import secrets; print(secrets.token_hex(32))"
ERP_SSO_SECRET=
# Origine exacte de l'ERP, seule autorisée à afficher cette app en iframe.
ERP_ORIGIN=https://erp.runner.golf

# --- YouTube (Google Cloud Console > API YouTube Data v3) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/accounts/youtube/callback

# --- TikTok (developers.tiktok.com > Content Posting API) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8000/accounts/tiktok/callback

# --- Meta: Instagram + Facebook (developers.facebook.com) ---
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8000/accounts/meta/callback

# --- LinkedIn (developer.linkedin.com) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/accounts/linkedin/callback
