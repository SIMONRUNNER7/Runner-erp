# Application
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://runner:runner_password@localhost:5432/runner_erp

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Shopify
SHOPIFY_SHOP_DOMAIN=your-shop.myshopify.com
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SHOPIFY_ACCESS_TOKEN=your_shopify_access_token
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_secret

# Vos Factures
VOS_FACTURES_API_TOKEN=your_vos_factures_token
VOS_FACTURES_BASE_URL=https://www.vosFactures.com/api/v1

# Google Sheets
GOOGLE_SHEETS_SPREADSHEET_ID=1pcdlvgVpJugMzGoaIaVTFdiUpCSHXLiXj9ugj_kjf6I
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----"

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@runner-erp.com
PRESIDENT_EMAIL=president@runner.com

# Communication / Marketing (app Python, voir marketing/DEPLOY.md)
# URL publique de l'app Communication, sans slash final. Vide = onglet désactivé.
MARKETING_APP_URL=https://communication.runner.golf
# Secret partagé pour la connexion automatique (SSO). Doit être STRICTEMENT
# identique à ERP_SSO_SECRET dans marketing/.env.
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MARKETING_SSO_SECRET=

# Postgres (for Docker)
POSTGRES_USER=runner
POSTGRES_PASSWORD=runner_password
POSTGRES_DB=runner_erp
