{{ 'b2b-portal.css' | asset_url | stylesheet_tag }}

<div class="b2b-portal-wrapper">

  {% if customer %}
    {%- assign is_b2b = false -%}
    {%- assign b2b_discount = 0 -%}
    {%- for tag in customer.tags -%}
      {%- if tag == 'b2b' -%}{%- assign is_b2b = true -%}{%- endif -%}
      {%- if tag contains 'b2b-' -%}
        {%- assign b2b_discount = tag | remove: 'b2b-' | times: 1 -%}
      {%- endif -%}
    {%- endfor -%}

    {% if is_b2b %}
      <div class="b2b-welcome">
        <div class="b2b-welcome__header">
          <div class="b2b-welcome__avatar">{{ customer.first_name | slice: 0 | upcase }}</div>
          <div>
            <h2 class="b2b-welcome__name">{{ customer.first_name }}</h2>
            <p class="b2b-welcome__company">{{ customer.default_address.company }}</p>
          </div>
        </div>
        {% if b2b_discount > 0 %}
          <div class="b2b-discount-banner">
            <span class="b2b-discount-badge">-{{ b2b_discount }}%</span>
            <div>
              <p class="b2b-discount-title">{{ t_discount_active }}</p>
              <p class="b2b-discount-sub">-{{ b2b_discount }}% {{ t_discount_sub }}</p>
            </div>
          </div>
        {% else %}
          <div class="b2b-discount-banner b2b-discount-banner--standard">
            <span class="b2b-discount-badge b2b-discount-badge--standard">B2B</span>
            <div>
              <p class="b2b-discount-title">{{ t_b2b_active }}</p>
              <p class="b2b-discount-sub">{{ t_b2b_sub }}</p>
            </div>
          </div>
        {% endif %}
        <div class="b2b-actions">
          <a href="/collections/all" class="b2b-btn b2b-btn--primary">{{ t_catalog }}</a>
          <a href="/account/orders" class="b2b-btn b2b-btn--secondary">{{ t_orders }}</a>
        </div>
        <p class="b2b-logout-link">{{ t_not_you }} <a href="/account/logout">{{ t_logout }}</a></p>
      </div>

    {% else %}
      <div class="b2b-card b2b-pending">
        <h2>{{ t_pending_title }}</h2>
        <p><strong>{{ customer.email }}</strong> {{ t_pending_body }}</p>
        <p>{{ t_pending_sub }}</p>
        <a href="/account/logout" class="b2b-btn b2b-btn--secondary">{{ t_logout }}</a>
      </div>
    {% endif %}

  {% else %}
    <div class="b2b-auth-container">
      <div class="b2b-auth-header">
        <h1 class="b2b-auth-title">{{ t_title }}</h1>
        <p class="b2b-auth-subtitle">{{ t_subtitle }}</p>
      </div>

      <div class="b2b-tabs">
        <button class="b2b-tab b2b-tab--active" onclick="b2bShowTab('login', this)">{{ t_login_tab }}</button>
        <button class="b2b-tab" onclick="b2bShowTab('register', this)">{{ t_register_tab }}</button>
      </div>

      <div id="b2b-tab-login" class="b2b-tab-panel">
        {% form 'customer_login', return_to: '/pages/b2b-portal' %}
          {{ form.errors | default_errors }}
          <div class="b2b-field">
            <label for="b2b-email">{{ t_email }}</label>
            <input type="email" name="customer[email]" id="b2b-email" placeholder="contact@boutique.fr" autocomplete="email" required />
          </div>
          <div class="b2b-field">
            <label for="b2b-password">{{ t_password }}</label>
            <input type="password" name="customer[password]" id="b2b-password" placeholder="..." autocomplete="current-password" required />
          </div>
          <button type="submit" class="b2b-btn b2b-btn--primary b2b-btn--full">{{ t_submit_login }}</button>
          <p class="b2b-form-note"><a href="/account/reset_password">{{ t_forgot }}</a></p>
        {% endform %}
      </div>

      <div id="b2b-tab-register" class="b2b-tab-panel" style="display:none">
        <form id="b2b-register-form">
          <div class="b2b-field">
            <label for="b2b-reg-company">{{ t_company }}</label>
            <input type="text" id="b2b-reg-company" placeholder="Runner Golf Paris" required />
          </div>
          <div class="b2b-field">
            <label for="b2b-reg-name">{{ t_name }}</label>
            <input type="text" id="b2b-reg-name" placeholder="Jean Dupont" required />
          </div>
          <div class="b2b-field">
            <label for="b2b-reg-email">{{ t_email }} *</label>
            <input type="email" id="b2b-reg-email" placeholder="contact@boutique.fr" required />
          </div>
          <div class="b2b-field">
            <label for="b2b-reg-phone">{{ t_phone }}</label>
            <input type="tel" id="b2b-reg-phone" placeholder="+33 6 12 34 56 78" />
          </div>
          <div class="b2b-field">
            <label for="b2b-reg-message">{{ t_more_info }}</label>
            <textarea id="b2b-reg-message" rows="3" placeholder="..."></textarea>
          </div>
          <p id="b2b-reg-error" style="color:#dc2626;font-size:0.85rem;margin-bottom:0.5rem;display:none"></p>
          <p id="b2b-reg-success" class="b2b-success" style="display:none">{{ t_sent }}</p>
          <button type="submit" class="b2b-btn b2b-btn--primary b2b-btn--full">{{ t_submit_register }}</button>
        </form>
      </div>
    </div>
  {% endif %}

</div>

<script>
  function b2bShowTab(tab, btn) {
    document.querySelectorAll('.b2b-tab-panel').forEach(function(el) { el.style.display = 'none'; });
    document.querySelectorAll('.b2b-tab').forEach(function(el) { el.classList.remove('b2b-tab--active'); });
    document.getElementById('b2b-tab-' + tab).style.display = 'block';
    btn.classList.add('b2b-tab--active');
  }
  if (window.location.search.indexOf('register=true') !== -1) {
    b2bShowTab('register', document.querySelectorAll('.b2b-tab')[1]);
  }

  var regForm = document.getElementById('b2b-register-form');
  if (regForm) {
    regForm.addEventListener('submit', async function(e) {
      e.preventDefault();
      var btn = this.querySelector('button[type=submit]');
      var err = document.getElementById('b2b-reg-error');
      var ok = document.getElementById('b2b-reg-success');
      btn.disabled = true;
      err.style.display = 'none';
      ok.style.display = 'none';
      try {
        var res = await fetch('https://erp.runner.golf/api/b2b/auth/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            company: document.getElementById('b2b-reg-company').value,
            name: document.getElementById('b2b-reg-name').value,
            email: document.getElementById('b2b-reg-email').value,
            phone: document.getElementById('b2b-reg-phone').value,
            notes: document.getElementById('b2b-reg-message').value,
            password: Math.random().toString(36).slice(2) + Math.random().toString(36).slice(2)
          })
        });
        if (res.ok) {
          regForm.style.display = 'none';
          ok.style.display = 'block';
        } else {
          var data = await res.json();
          err.textContent = data.error || 'Erreur';
          err.style.display = 'block';
          btn.disabled = false;
        }
      } catch(e) {
        err.textContent = '{{ t_conn_error }}';
        err.style.display = 'block';
        btn.disabled = false;
      }
    });
  }
</script>

